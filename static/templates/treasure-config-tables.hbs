<div class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    <div class="treasure-scroll">
        {{#each tiers as |tier tierIndex|}}
            <fieldset class="treasure-tier">
                <legend>{{localize "PocketChange.TreasureConfig.Tier"}}</legend>

                <div class="treasure-tier-range">
                    <span class="treasure-tier-label">
                        {{#if @root.attributePath}}
                            {{localize "PocketChange.TreasureConfig.WhenAttributeIs" attribute=@root.attributePath}}
                        {{else}}
                            {{localize "PocketChange.TreasureConfig.WhenAttributeIsUnset"}}
                        {{/if}}
                    </span>
                    <input
                        type="number"
                        name="tiers.{{tierIndex}}.min"
                        value="{{tier.min}}"
                        step="any"
                        aria-label="{{localize 'PocketChange.TreasureConfig.From'}}"
                    />
                    <span class="treasure-tier-joiner">{{localize "PocketChange.TreasureConfig.To"}}</span>
                    <input
                        type="number"
                        name="tiers.{{tierIndex}}.max"
                        value="{{tier.max}}"
                        step="any"
                        placeholder="{{localize 'PocketChange.TreasureConfig.NoLimit'}}"
                        aria-label="{{localize 'PocketChange.TreasureConfig.To'}}"
                    />
                    <button
                        type="button"
                        class="icon"
                        data-action="deleteTier"
                        data-tier-index="{{tierIndex}}"
                        data-tooltip
                        aria-label="{{localize 'PocketChange.TreasureConfig.DeleteTier'}}"
                    >
                        <i class="fa-solid fa-trash" inert></i>
                    </button>
                </div>

                <table class="treasure-rows flexcol">
                    <thead>
                        <tr class="flexrow">
                            <th class="treasure-add flexrow">
                                <button
                                    type="button"
                                    class="inline-control icon fa-solid fa-plus"
                                    data-action="addRow"
                                    data-tier-index="{{tierIndex}}"
                                    data-tooltip
                                    aria-label="{{localize 'PocketChange.TreasureConfig.AddRow'}}"
                                ></button>
                            </th>
                            <th class="treasure-roll flexrow">{{localize "PocketChange.TreasureConfig.Roll"}}</th>
                            {{#each ../currencies as |currency|}}
                                <th class="flexrow">{{currency.label}}</th>
                            {{/each}}
                            <th class="treasure-delete flexrow"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each tier.rows as |row rowIndex|}}
                            <tr class="flexrow">
                                <td class="treasure-add flexrow"></td>
                                <td class="treasure-roll flexrow">
                                    <input
                                        type="number"
                                        name="tiers.{{tierIndex}}.rows.{{rowIndex}}.rangeStart"
                                        value="{{row.rangeStart}}"
                                    />
                                    <span class="dash">-</span>
                                    <input
                                        type="number"
                                        name="tiers.{{tierIndex}}.rows.{{rowIndex}}.rangeEnd"
                                        value="{{row.rangeEnd}}"
                                    />
                                </td>
                                {{#each row.formulas as |formula currencyIndex|}}
                                    <td class="flexrow">
                                        <input
                                            type="text"
                                            name="tiers.{{tierIndex}}.rows.{{rowIndex}}.formulas.{{currencyIndex}}"
                                            value="{{formula}}"
                                        />
                                    </td>
                                {{/each}}
                                <td class="treasure-delete flexrow">
                                    <button
                                        type="button"
                                        class="inline-control icon fa-solid fa-trash"
                                        data-action="deleteRow"
                                        data-tier-index="{{tierIndex}}"
                                        data-row-index="{{rowIndex}}"
                                        data-tooltip
                                        aria-label="{{localize 'PocketChange.TreasureConfig.DeleteRow'}}"
                                    ></button>
                                </td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            </fieldset>
        {{/each}}

        {{#unless tiers.length}}
            <p class="hint">{{localize "PocketChange.TreasureConfig.NoTiers"}}</p>
        {{/unless}}

        <button type="button" data-action="addTier">
            <i class="fa-solid fa-plus" inert></i>
            {{localize "PocketChange.TreasureConfig.AddTier"}}
        </button>
    </div>
</div>
